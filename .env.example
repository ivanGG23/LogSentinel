# Copia este archivo a .env y cambia los valores:  cp .env.example .env
# (.env NO se sube a git)

POSTGRES_USER=logsentinel
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=logsentinel

# Genera uno con:  openssl rand -hex 32
JWT_SECRET=cambia-por-un-valor-aleatorio-largo

# Opcional (minutos de vida del token; si no se define, usa el valor por defecto del código)
# JWT_EXPIRE_MINUTES=60
