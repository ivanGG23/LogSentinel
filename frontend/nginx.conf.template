# Dashboard de LogSentinel detrás del HTTPS de la plataforma (Railway termina TLS).
# nginx sustituye ${PORT} y ${API_URL} al arrancar.
server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${API_URL}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
}
